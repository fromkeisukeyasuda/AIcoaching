# ── AI（会話と評価で、別々に選べます）──
# 形式: anthropic / anthropic:モデル名 / gemini / gemini:モデル名
# AI_CHAT_MODEL=anthropic:claude-haiku-5-5   # 会話（相談・練習）用
# AI_EVAL_MODEL=anthropic                    # 評価・振り返りシート用（geminiの既定は gemini-2.5-pro）
# AI_MODEL=anthropic                         # 上の2つが未設定のときの共通設定（未設定なら anthropic）
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=                            # gemini を使うときだけ

# ── VOICEVOX（未設定なら、同じPCの http://127.0.0.1:50021）──
# VOICEVOX_URL=https://voicevox-xxxxx-an.a.run.app   # クラウドのエンジン（Cloud Run）
# VOICEVOX_SA_JSON=                                  # 認証必須にした場合の、サービスアカウントのJSON（または、そのbase64）
